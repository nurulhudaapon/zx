pub fn Page(ctx: zx.PageContext) !zx.Component {
    _ = try zx.db.run(@embedFile("../db/migrations/init.sql"), .empty);
    _ = try zx.db.run(
        \\INSERT INTO ziex (id, count)
        \\SELECT 1, 0
        \\WHERE NOT EXISTS (SELECT 1 FROM ziex WHERE id = 1)
    , .empty);

    const CountRow = struct { count: i64 };
    var count: i128 = if (try zx.db.row(ctx.arena, CountRow, "SELECT count FROM ziex WHERE id = 1", .{})) |row|
        row.count
    else
        0;

    const query = ctx.request.queries;
    if (query.get("reset")) |_|
        count = 0
    else if (query.get("increment")) |_|
        count += 1
    else if (query.get("decrement")) |_|
        count -= 1
    else
        count += 1;

    _ = try zx.db.run("UPDATE ziex SET count = ? WHERE id = 1", .{@as(i64, @intCast(count))});

    return (
        <main @allocator={ctx.arena}>
            <p>Ziex is a framework for building web applications with Zig.</p>
            <a href={zx.info.homepage} target="_blank">See Ziex Docs →</a>
            <br />
            <CounterComponent @rendering={.client} count={count} />
            <br />
            <hr />
            <div class="link-row">
                <a href="/form">Server State</a>
                <a href="/actions">Server Action</a>
                <a href="/actions/client">Client Action</a>
                <a href="/actions/server">Server Event</a>
            </div>
        </main>
    );
}

const zx = @import("zx");
pub const CounterComponent = @import("./client.zx").CounterComponent;
