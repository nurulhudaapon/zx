pub fn Page(ctx: zx.PageContext) zx.Component {
    return (
        <main @allocator={ctx.arena}>
            <div class="page-head">
                <h1>Actions</h1>
                <p>Invoke Zig functions from a form. Same handler, client or server render.</p>
            </div>
            <div class="grid">
                <section class="card">
                    <h3>Client-rendered</h3>
                    <p>Hydrated form, action still runs on the server.</p>
                    <LoginForm @client name="Ziex Client" />
                </section>
                <section class="card">
                    <h3>Server-rendered</h3>
                    <p>Plain HTML form posting to the same action.</p>
                    <LoginForm name="Ziex Server" />
                </section>
            </div>
        </main>
    );
}

const LoginInput = struct { name: []const u8, id: i32 = 123 };

pub fn LoginForm(ctx: *zx.ComponentCtx(LoginInput)) zx.Component {
    return (
        <form @allocator={ctx.allocator} action={handleLogin}>
            <input name="name" value={ctx.props.name} />
            <input name="id" value={ctx.props.id} />
            <button>Submit</button>
        </form>
    );
}

fn handleLogin(data: LoginInput) void {
    zx.log.info("\nName: {s}\nID: {d}\n", .{ data.name, data.id });
}

pub const options: zx.PageOptions = .{
    .methods = &.{ .GET, .POST },
};

const zx = @import("zx");
